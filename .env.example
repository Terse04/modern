# ========================================================
# MODERN — Social Listening Platform Environment Config
# ========================================================

# Data Mode: 'demo' (default, works out of the box) or 'supabase'
VITE_DATA_MODE=demo

# Supabase Configuration (Optional for local demo mode)
# Required only when VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare R2 / Audio CDN (Optional, production ready)
# Public bucket URL for streaming authorized audio files
VITE_AUDIO_CDN_URL=

# App Base URL for Share / QR Codes
VITE_APP_URL=http://localhost:3000
